{
  "name": "engram-chat",
  "version": "5.0.56",
  "description": "Sidebar chat powered by your local LLM with full vault context",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "test": "vitest run",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "sync": "powershell -ExecutionPolicy Bypass -File ./scripts/sync-plugin.ps1",
    "deploy": "npm run build && npm run sync"
  },
  "keywords": [
    "obsidian",
    "llm",
    "llama",
    "ai",
    "chat"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.19.43",
    "esbuild": "0.17.3",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "4.7.4",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.5.438"
  }
}
